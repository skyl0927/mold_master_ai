{
  "name": "capture-annotate-pro",
  "version": "1.0.0",
  "description": "A powerful tool to capture your screen, add annotations, and export reports.",
  "main": "main.js",
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "start": "npm run build && electron .",
    "web": "vite",
    "graph:trace": "node scripts/run-graph-trace.js",
    "knowledge:trace": "node scripts/run-process-knowledge-trace.js",
    "eval:graph": "node scripts/run-approved-graph-benchmark.js",
    "eval:vision": "node scripts/run-multimodal-vision-benchmark.js",
    "eval:vision:validate": "node scripts/run-multimodal-vision-benchmark.js --validate-only",
    "eval:vision:sync-approved": "node scripts/sync-approved-vision-fixtures.js",
    "eval:vision:approved": "node scripts/run-multimodal-vision-benchmark.js --manifest eval/vision-approved/manifest.json",
    "vision:candidates:sync-card": "node scripts/sync-knowledge-card-vision-candidates.js",
    "vision:review-packet": "node scripts/build-vision-human-review-packet.js",
    "vision:review-packet:audit": "node scripts/audit-vision-human-review-packet.js",
    "knowledge:web:collect": "node scripts/collect-web-injection-defect-cases.js",
    "knowledge:web:audit": "node scripts/audit-web-knowledge-cards.js",
    "knowledge:web:validate-common-agent": "node scripts/validate-web-cases-against-common-agent.js",
    "migration:gate-status": "node scripts/build-migration-gate-status.js",
    "test:contracts": "node scripts/run-contract-tests.js",
    "test:capture": "node --test tests/captureGeometry.test.js tests/captureFrameCache.test.js",
    "test:translation": "node --test tests/translationRequest.test.js",
    "test:benchmark": "node --test tests/multimodalBenchmark.test.js",
    "test:candidates": "node --test tests/localVisionCandidate.test.js tests/knowledgeCardVisionCandidateSync.test.js tests/visionReviewPriority.test.js tests/visionReviewQueue.test.js",
    "test:review-packet": "node --test tests/visionHumanReviewPacket.test.js",
    "test:vision-approval": "node --test tests/localVisionApproval.test.js",
    "test:review-decisions": "node --test tests/visionReviewDecisionLedger.test.js",
    "test:report-basic-info": "node --test tests/reportBasicInfo.test.js",
    "test:migration-gate-status": "node --test tests/migrationGateStatus.test.js",
    "test:web-knowledge": "node --test tests/webCrawlerPolicy.test.js tests/webKnowledgeCard.test.js tests/webDefectCaseCollector.test.js tests/webKnowledgeCardReviewLedger.test.js tests/webKnowledgeReviewStore.test.js tests/webKnowledgeReviewNavigation.test.js tests/webKnowledgeKoreanTranslation.test.js tests/expandedDefectTaxonomy.test.js",
    "test:electron": "npm run build && node scripts/electron-smoke.js",
    "test:electron:capture-fresh-frame": "npm run build && node scripts/electron-capture-fresh-frame-smoke.js",
    "test:electron:chat": "npm run build && node scripts/electron-common-agent-chat-smoke.js",
    "test:electron:migrate": "npm run build && node scripts/electron-process-knowledge-migration-smoke.js",
    "test:electron:transition": "npm run build && node scripts/electron-transition-report-smoke.js",
    "test:electron:multimodal": "npm run build && node scripts/electron-multimodal-diagnosis-smoke.js",
    "test:electron:hitl": "npm run build && node scripts/electron-hitl-review-smoke.js",
    "test:electron:vision-readiness": "npm run build && node scripts/electron-vision-readiness-smoke.js",
    "test:electron:dataset-manager": "npm run build && node scripts/electron-dataset-manager-smoke.js",
    "test:electron:vision-suggestion": "npm run build && node scripts/electron-vision-label-suggestion-smoke.js",
    "test:electron:vision-benchmark": "npm run build && node scripts/electron-vision-benchmark-smoke.js",
    "test:electron:vision-candidates": "npm run build && node scripts/electron-local-vision-candidate-smoke.js",
    "test:electron:vision-card-candidates": "npm run build && node scripts/electron-knowledge-card-candidate-smoke.js",
    "test:electron:vision-review-packet": "npm run build && node scripts/electron-vision-review-packet-smoke.js",
    "test:electron:vision-resolved": "npm run build && node scripts/electron-vision-resolved-review-smoke.js",
    "test:electron:vision-approval": "npm run build && node scripts/electron-vision-review-approval-smoke.js",
    "test:electron:review-decisions": "npm run build && node scripts/electron-vision-review-decisions-smoke.js",
    "test:electron:web-knowledge-hitl": "npm run build && node scripts/electron-web-knowledge-hitl-smoke.js",
    "test:electron:report-basic-info": "npm run build && node scripts/electron-report-basic-info-smoke.js",
    "test:electron:central-docs": "npm run build && node scripts/electron-central-document-smoke.js",
    "test:live:document-assist": "node scripts/live-common-agent-document-workflow.js",
    "build:css": "tailwindcss -i ./src/index.css -o ./build/styles.css",
    "build:js": "esbuild index.tsx toolbar.tsx components/RegionSelector.tsx --bundle --platform=browser --outdir=build/ --jsx=automatic --entry-names=[name]",
    "build": "npm run build:css && npm run build:js",
    "prepackage": "npm run build",
    "package": "electron-builder"
  },
  "dependencies": {
    "@google/genai": "^0.14.0",
    "better-sqlite3": "^11.10.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "mammoth": "^1.7.2",
    "openai": "^4.52.2",
    "pdfjs-dist": "^4.4.168",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@playwright/test": "^1.61.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20.14.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.21.4",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.example.capture-annotate-pro",
    "productName": "Capture & Annotate Pro",
    "files": [
      "build/",
      "main.js",
      "localVisionCandidate.js",
      "migrationGateStatus.js",
      "shared/defect-taxonomy.js",
      "captureGeometry.js",
      "captureFrameCache.js",
      "visionReviewDecisionLedger.js",
      "webKnowledgeCard.js",
      "webKnowledgeCardReviewLedger.js",
      "webKnowledgeReviewStore.js",
      "webKnowledgeReviewNavigation.js",
      "preload.js",
      "database.js",
      "layouts.js",
      "index.html",
      "toolbar.html",
      "overlay.html"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "run-multimodal-vision-benchmark.js",
          "sync-approved-vision-fixtures.js",
          "crop-benchmark-roi.py",
          "lib/multimodal-benchmark.js"
        ]
      },
      {
        "from": "shared/defect-taxonomy.js",
        "to": "shared/defect-taxonomy.js"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    }
  }
}
