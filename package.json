      "preload.js",
      "database.js",
      "layouts.js",
      "index.html",
      "toolbar.html",
      "overlay.html"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "run-multimodal-vision-benchmark.js",
          "sync-approved-vision-fixtures.js",
          "crop-benchmark-roi.py",
          "lib/approved-vision-fixture-quality.js",
          "lib/multimodal-benchmark.js"
        ]
      },
      {
        "from": "shared/defect-taxonomy.js",
        "to": "shared/defect-taxonomy.js"
      },
      {
        "from": "visionObservation.js",
        "to": "visionObservation.js"
      },
      {
        "from": "visionCaptureProtocol.js",
        "to": "visionCaptureProtocol.js"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    }
