    "appId": "com.example.capture-annotate-pro",
    "productName": "Capture & Annotate Pro",
    "files": [
      "build/",
      "main.js",
      "apiConfigDefaults.js",
      "localVisionCandidate.js",
      "migrationGateStatus.js",
      "shared/defect-taxonomy.js",
      "captureGeometry.js",
      "captureFrameCache.js",
